---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../site';

const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const allApps = (await getCollection('apps')).sort(byDate);
const featured = allApps.filter((a) => a.data.featured);
const apps = (featured.length ? featured : allApps).slice(0, 3);

const sewing = (await getCollection('sewing')).sort(byDate).slice(0, 3);
const tints = ['t-blue', 't-red', 't-yellow'];
---
<Base current="home">
  <section class="container hero">
    <div class="hero-text">
      <p class="pixel" style="color: var(--blue-text)">Player 1 · Sylvia</p>
      <h1>I make apps, clothes and music.</h1>
      <p class="lead">I'm a software engineer who likes building things, in code and out of it. This is where I keep the apps I've made, my sewing projects and, soon, my music.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#apps"><span class="tri" aria-hidden="true">▶</span> See my apps</a>
        <a class="btn btn-outline" href={url('sewing/')}>Visit the sewing room</a>
      </div>
    </div>
    <div class="hero-art float" aria-hidden="true">
      <svg viewBox="0 0 360 360" style="perspective: 800px">
        <g class="gem">
          <polygon points="180,20 300,110 180,160" fill="#2B4BD8" />
          <polygon points="180,20 60,110 180,160" fill="#4A68F0" />
          <polygon points="60,110 180,160 120,280" fill="#E5383B" />
          <polygon points="300,110 180,160 240,280" fill="#F5B700" />
          <polygon points="180,160 120,280 240,280" fill="#14A05A" />
          <polygon points="120,280 240,280 180,340" fill="#0E7A44" />
          <polygon points="60,110 120,280 40,220" fill="#B82326" />
          <polygon points="300,110 240,280 320,220" fill="#D39A00" />
        </g>
        <ellipse cx="180" cy="352" rx="90" ry="6" fill="currentColor" opacity="0.08" />
      </svg>
    </div>
  </section>

  <nav class="container worlds" aria-label="Sections">
    <a class="world" href="#apps" style="--accent: var(--blue)">
      <span class="slot-num">World 1</span>
      <span class="world-title">Apps</span>
    </a>
    <a class="world" href="#sewing" style="--accent: var(--red)">
      <span class="slot-num">World 2</span>
      <span class="world-title">Sewing</span>
    </a>
    <a class="world" href="#music" style="--accent: var(--yellow)">
      <span class="slot-num">World 3</span>
      <span class="world-title">Music</span>
    </a>
  </nav>

  <section id="apps" class="container section">
    <div class="section-head">
      <div>
        <p class="pixel" style="color: var(--blue-text)">World 1 · Apps</p>
        <h2 class="section-title">Things I've built</h2>
      </div>
      <a href={url('apps/')} style="font-weight: 600">All apps →</a>
    </div>
    <div class="grid-work">
      {apps.map((a, i) => <AppCard app={a} tint={tints[i % 3]} />)}
    </div>
  </section>

  <section id="sewing" class="inverse">
    <div class="container section split">
      <div class="text">
        <p class="pixel pixel-yellow">World 2 · Sewing</p>
        <h2 class="section-title" style="margin-bottom: 16px">The sewing room</h2>
        <p class="lead" style="margin: 0 0 28px">Garments, costumes and other projects I've made, with notes on patterns and fabric.</p>
        <a class="btn btn-yellow" href={url('sewing/')}>Browse the portfolio</a>
      </div>
      <div class="media thumbs">
        {sewing.map((p, i) => (
          <a href={url(`sewing/${p.id}/`)} aria-label={p.data.title}>
            {p.data.image
              ? <img src={url(p.data.image)} alt={p.data.imageAlt ?? ''} loading="lazy" />
              : <div class={`placeholder ${tints[i % 3]}`} style="height:100%;border-radius:0">[Photo]</div>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="music" class="container section">
    <div class="loading-card">
      <div>
        <p class="pixel" style="color: var(--blue-text)">World 3 · Music · Loading…</p>
        <h2>Music is coming soon</h2>
        <p class="muted" style="font-size: 18px">I'm working on my first tracks. <a href={url('music/')}>Get notified</a> when they're out.</p>
      </div>
      <div class="loader" role="img" aria-label="Loading bar at 60 percent">
        <span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span class="blink"></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </section>

  <section class="container" style="padding-bottom: 96px">
    <div class="bonus">
      <p class="pixel" style="color: var(--green-text); margin: 0">Bonus stage</p>
      <p style="margin: 0; font-size: 18px">I also help friends and small projects with their websites now and then. <a href={url('contact/')}>Say hi</a> if you'd like a hand.</p>
    </div>
  </section>
</Base>
